rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdminOrTeacher() {
      return isAuthenticated() && 
        (request.auth.token.role == 'admin' || request.auth.token.role == 'teacher');
    }

    // Educational study materials & PDFs:
    // Read: open to students
    // Write: restricted to verified teachers/admins, maximum 25MB
    match /materials/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 25 * 1024 * 1024
                   && (request.resource.contentType.matches('application/pdf')
                       || request.resource.contentType.matches('image/.*'));
    }

    // Question bank images and diagrams: max 5MB
    match /question-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Generated student certificates: max 5MB
    match /certificates/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024;
    }
  }
}
